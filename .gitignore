# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# MkDocs-Build: wird von .github/workflows/docs.yml per gh-deploy auf gh-pages erzeugt,
# gehört nicht auf main (einmalig: git rm -r --cached site)
site/

# Virtuelle Umgebungen
.venv/
venv/
env/

# Läufe / lokale Ausgaben
out/
llm_cache/
# Regressions-Baselines: verweisen auf lokale Referenzverzeichnisse (offene Frage AP-01).
# Ausnahme: die synthetische Baseline enthält keinen Normtext und ist CI-tauglich (ENT-27).
baselines/*
!baselines/synthetic.json

# Schlüssel / Umgebung (niemals committen)
.api_key
*.api_key
.env

# Betriebssystem / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Coding Assist
CLAUDE.md
ROADMAP.md
STATUS.md
ARCHITEKTUR.md

# Interne deutsche Notizen (nicht Teil der veröffentlichten docs/)
notizen/

# Unbeaufsichtigte Läufe: Konfiguration mit absoluten Pfaden, Prompts, Protokolle
.claude/
prompts/
runs/
nachtlauf.sh
deutungslauf_deepseek.sh
# Arbeitskopie der Deutungsläufe: Laufkopie, ausgeleitete Prompts, Antworten
arbeit/

# Urheberrechtlich geschützte Korpus-Fixtures
tests/fixtures/korpus/

# Synthetischer Korpus: die Markdown-Dateien sind die Quelle, die DOCX sind abgeleitet
# (tools/build_synthetic.py erzeugt sie neu)
tests/fixtures/synthetic/*.docx